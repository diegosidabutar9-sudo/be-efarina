generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model branches {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id    String?         @db.Uuid
  code          String          @unique @db.VarChar(50)
  name          String          @db.VarChar(150)
  city_id       String?         @db.Uuid
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  created_by    String?         @db.VarChar(50)
  updated_at    DateTime?       @default(now()) @db.Timestamptz(6)
  updated_by    String?         @db.VarChar(50)
  deleted_at    DateTime?       @db.Timestamptz(6)
  deleted_by    String?         @db.VarChar(50)
  cities        cities?         @relation(fields: [city_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  companies     companies?      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notifications notifications[]
  user_roles    user_roles[]
}

model cities {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  state_id       String?         @db.Uuid
  name           String          @db.VarChar(150)
  postal_code    String?         @db.VarChar(20)
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  created_by     String?         @db.VarChar(50)
  updated_at     DateTime?       @default(now()) @db.Timestamptz(6)
  updated_by     String?         @db.VarChar(50)
  deleted_at     DateTime?       @db.Timestamptz(6)
  deleted_by     String?         @db.VarChar(50)
  branches       branches[]
  states_regions states_regions? @relation(fields: [state_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model companies {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code        String      @unique @db.VarChar(50)
  name        String      @db.VarChar(150)
  currency_id String?     @db.Uuid
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  created_by  String?     @db.VarChar(50)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_by  String?     @db.VarChar(50)
  deleted_at  DateTime?   @db.Timestamptz(6)
  deleted_by  String?     @db.VarChar(50)
  branches    branches[]
  currencies  currencies? @relation(fields: [currency_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model countries {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  iso_code       String           @unique @db.VarChar(5)
  name           String           @db.VarChar(150)
  phone_code     String?          @db.VarChar(10)
  currency_id    String?          @db.Uuid
  is_active      Boolean?         @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  created_by     String?          @db.VarChar(50)
  updated_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_by     String?          @db.VarChar(50)
  deleted_at     DateTime?        @db.Timestamptz(6)
  deleted_by     String?          @db.VarChar(50)
  currencies     currencies?      @relation(fields: [currency_id], references: [id], onUpdate: NoAction)
  states_regions states_regions[]
}

model currencies {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code           String      @unique @db.VarChar(10)
  name           String      @db.VarChar(100)
  symbol         String      @db.VarChar(10)
  decimal_digits Int?        @default(2)
  is_active      Boolean?    @default(true)
  created_at     DateTime?   @default(now()) @db.Timestamptz(6)
  created_by     String?     @db.VarChar(50)
  updated_at     DateTime?   @default(now()) @db.Timestamptz(6)
  updated_by     String?     @db.VarChar(50)
  deleted_at     DateTime?   @db.Timestamptz(6)
  deleted_by     String?     @db.VarChar(50)
  companies      companies[]
  countries      countries[]
}

model menus {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parent_id   String?      @db.Uuid
  module_id   String       @db.Uuid
  title       String       @db.VarChar(100)
  path        String?      @db.VarChar(255)
  icon        String?      @db.VarChar(50)
  sequence    Int?         @default(0)
  created_at  DateTime?    @default(now()) @db.Timestamptz(6)
  created_by  String?      @db.VarChar(50)
  updated_at  DateTime?    @default(now()) @db.Timestamptz(6)
  updated_by  String?      @db.VarChar(50)
  deleted_at  DateTime?    @db.Timestamptz(6)
  deleted_by  String?      @db.VarChar(50)
  modules     modules      @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menus       menus?       @relation("menusTomenus", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_menus menus[]      @relation("menusTomenus")
  role_menus  role_menus[]
}

model modules {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(100)
  description String?
  icon        String?       @db.VarChar(50)
  sequence    Int?          @default(0)
  is_active   Boolean?      @default(true)
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  created_by  String?       @db.VarChar(50)
  updated_at  DateTime?     @default(now()) @db.Timestamptz(6)
  updated_by  String?       @db.VarChar(50)
  deleted_at  DateTime?     @db.Timestamptz(6)
  deleted_by  String?       @db.VarChar(50)
  menus       menus[]
  permissions permissions[]
}

model notifications {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String?   @db.Uuid
  branch_id  String?   @db.Uuid
  message    String
  type       String?   @default("info") @db.VarChar(20)
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  created_by String?   @db.VarChar(50)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_by String?   @db.VarChar(50)
  deleted_at DateTime? @db.Timestamptz(6)
  deleted_by String?   @db.VarChar(50)
  branches   branches? @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model permissions {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  module_id        String             @db.Uuid
  code             String             @unique @db.VarChar(100)
  name             String             @db.VarChar(100)
  description      String?
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  created_by       String?            @db.VarChar(50)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_by       String?            @db.VarChar(50)
  deleted_at       DateTime?          @db.Timestamptz(6)
  deleted_by       String?            @db.VarChar(50)
  modules          modules            @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role_permissions role_permissions[]
}

model role_menus {
  role_id    String    @db.Uuid
  menu_id    String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  created_by String?   @db.VarChar(50)
  menus      menus     @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, menu_id])
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  created_by    String?     @db.VarChar(50)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code             String             @unique @db.VarChar(50)
  name             String             @db.VarChar(100)
  description      String?
  is_system        Boolean?           @default(false)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  created_by       String?            @db.VarChar(50)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_by       String?            @db.VarChar(50)
  deleted_at       DateTime?          @db.Timestamptz(6)
  deleted_by       String?            @db.VarChar(50)
  role_menus       role_menus[]
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model states_regions {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  country_id String?    @db.Uuid
  name       String     @db.VarChar(150)
  code       String?    @db.VarChar(20)
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  created_by String?    @db.VarChar(50)
  updated_at DateTime?  @default(now()) @db.Timestamptz(6)
  updated_by String?    @db.VarChar(50)
  deleted_at DateTime?  @db.Timestamptz(6)
  deleted_by String?    @db.VarChar(50)
  cities     cities[]
  countries  countries? @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_roles {
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  branch_id  String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  created_by String?   @db.VarChar(50)
  branches   branches  @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id, branch_id])
}

model users {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  first_name    String          @db.VarChar(100)
  last_name     String?         @db.VarChar(100)
  username      String          @unique @db.VarChar(50)
  email         String          @unique @db.VarChar(150)
  password      String          @db.VarChar(255)
  is_active     Boolean?        @default(true)
  locale        String?         @default("en-US") @db.VarChar(10)
  timezone      String?         @default("UTC") @db.VarChar(50)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  created_by    String?         @db.VarChar(50)
  updated_at    DateTime?       @default(now()) @db.Timestamptz(6)
  updated_by    String?         @db.VarChar(50)
  deleted_at    DateTime?       @db.Timestamptz(6)
  deleted_by    String?         @db.VarChar(50)
  notifications notifications[]
  user_roles    user_roles[]
}
