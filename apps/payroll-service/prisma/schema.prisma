generator client {
  provider        = "prisma-client-js"
  output          = "../../../node_modules/@prisma/client-payroll"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("PAYROLL_DATABASE_URL")
  schemas  = ["payroll"]
}

model payrolls {
  id              String            @id @default(uuid()) @db.Uuid
  user_id         String            @db.Uuid
  period_start    DateTime          @db.Date
  period_end      DateTime          @db.Date
  basic_salary    Decimal           @db.Decimal(12, 2)
  allowances      Decimal           @default(0) @db.Decimal(12, 2)
  deductions      Decimal           @default(0) @db.Decimal(12, 2)
  net_salary      Decimal           @db.Decimal(12, 2)
  payment_method  String?           @db.VarChar(50)
  payment_date    DateTime?         @db.Timestamptz(6)
  status          String            @db.VarChar(50)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @db.Timestamptz(6)
  
  payroll_details payroll_details[]

  @@schema("payroll")
}

model payroll_details {
  id             String    @id @default(uuid()) @db.Uuid
  payroll_id     String    @db.Uuid
  component_type String    @db.VarChar(50) // ALLOWANCE or DEDUCTION
  component_name String    @db.VarChar(100) // e.g. "BPJS Kesehatan", "Tunjangan Shift"
  amount         Decimal   @db.Decimal(12, 2)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  payroll        payrolls  @relation(fields: [payroll_id], references: [id], onDelete: Cascade)

  @@schema("payroll")
}
