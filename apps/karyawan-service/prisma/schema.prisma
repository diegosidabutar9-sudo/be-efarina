generator client {
  provider        = "prisma-client-js"
  output          = "../../../node_modules/@prisma/client-karyawan"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("KARYAWAN_DATABASE_URL")
  schemas  = ["hris"]
}

model departments {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(50)
  name        String      @db.VarChar(150)
  manager_id  String?     @db.Uuid
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  employees   employees[]

  @@schema("hris")
}

model positions {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(50)
  name        String      @db.VarChar(150)
  base_salary Decimal?    @db.Decimal(12, 2)
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  employees   employees[]

  @@schema("hris")
}

model employees {
  id                     String      @id @default(uuid()) @db.Uuid
  user_id                String      @unique @db.Uuid
  employee_id            String      @unique @db.VarChar(50)
  department_id          String?     @db.Uuid
  position_id            String?     @db.Uuid
  employment_status      String      @db.VarChar(50)
  medical_license_number String?     @db.VarChar(100)
  join_date              DateTime    @db.Date
  created_at             DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?   @default(now()) @db.Timestamptz(6)

  department             departments? @relation(fields: [department_id], references: [id])
  position               positions?   @relation(fields: [position_id], references: [id])

  @@schema("hris")
}
